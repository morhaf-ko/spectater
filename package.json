{
  "name": "spectater",
  "version": "0.6.0",
  "description": "Review OpenSpec changes in your browser and send selected-text feedback to your coding agent",
  "keywords": [
    "openspec",
    "review",
    "coding-agent",
    "claude-code",
    "codex",
    "spec-driven-development",
    "markdown"
  ],
  "homepage": "https://github.com/morhaf-ko/spectater#readme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.4",
  "bin": {
    "spectater": "bin/spectater.js"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test --timeout 30000 test/*.test.js",
    "test:browser": "bun --bun node_modules/@playwright/test/cli.js test",
    "test:package": "bun scripts/package-test.js",
    "smoke": "node scripts/smoke.js",
    "release:preflight": "node scripts/release-preflight.js",
    "lint": "biome ci .",
    "spec:check": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "check": "bun run lint && bun run test && bun run test:browser && bun run test:package && bun run smoke && bun run spec:check && git diff --check && bun audit",
    "format": "biome check --write ."
  },
  "dependencies": {
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@fission-ai/openspec": "1.17.0",
    "@playwright/test": "1.65.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/morhaf-ko/spectater.git"
  },
  "bugs": {
    "url": "https://github.com/morhaf-ko/spectater/issues"
  },
  "author": "Morhaf Kourbaj (https://morhaf.dev)"
}
