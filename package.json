{
  "name": "spectater",
  "version": "0.1.0",
  "description": "Local selected-text review for canonical OpenSpec changes",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.4 <1.5"
  },
  "packageManager": "bun@1.4.4",
  "bin": {
    "spectater": "bin/spectater.js"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "docs/",
    "integration/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "bun test --timeout 30000 test/*.test.js",
    "test:browser": "bun --bun node_modules/@playwright/test/cli.js test",
    "test:package": "bun scripts/package-test.js",
    "smoke": "bun scripts/smoke.js",
    "benchmark": "bun scripts/benchmark.js",
    "lint": "biome ci .",
    "spec:check": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "check": "bun run lint && bun run test && bun run test:browser && bun run test:package && bun run smoke -- --fixture local-review --no-open && bun run spec:check && git diff --check && bun audit",
    "format": "biome check --write ."
  },
  "dependencies": {
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@fission-ai/openspec": "1.16.1",
    "@playwright/test": "1.65.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/morhaf-ko/spectater.git"
  },
  "bugs": {
    "url": "https://github.com/morhaf-ko/spectater/issues"
  }
}
